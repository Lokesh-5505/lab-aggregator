# ==========================================
# Lab Aggregator - Environment Configuration
# ==========================================

# Port for the Express backend server
PORT=5000

# MongoDB Connection URI:
# - Leave empty to use local in-memory MongoDB
# - Or paste your MongoDB Atlas URI here:
#   e.g. mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/labaggregator?retryWrites=true&w=majority
MONGODB_URI=

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Frontend API Base URL (used when deploying or connecting to backend)
VITE_API_URL=http://localhost:5000
